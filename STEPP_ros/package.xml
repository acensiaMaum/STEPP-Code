<package format="3">
  <name>stepp_ros</name>
  <version>0.0.1</version>
  <description>Traversability estimation package using image features</description>

  <maintainer email="s.aegidius@ucl.ac.uk">Sebastian Aegidius</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Message generation (ROS2) -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Core ROS2 client libraries -->
  <build_depend>rclcpp</build_depend>
  <build_depend>rclpy</build_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <!-- Messages and common dependencies -->
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- Images, OpenCV bridge -->
  <build_depend>cv_bridge</build_depend>
  <exec_depend>cv_bridge</exec_depend>
  <build_depend>image_transport</build_depend>
  <exec_depend>image_transport</exec_depend>

  <!-- TF2 -->
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>

  <!-- PCL and conversions -->
  <build_depend>pcl_conversions</build_depend>
  <build_depend>pcl_ros</build_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>pcl_ros</exec_depend>

  <!-- Message filters (ROS2) -->
  <build_depend>message_filters</build_depend>
  <exec_depend>message_filters</exec_depend>

  <!-- Python dependencies (runtime) -->
  <exec_depend>torch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
